# Production REST API base URL (Axios)
# Nếu deploy cùng domain sau Nginx reverse proxy: /api
# Nếu deploy khác domain: https://api.yourdomain.com/api
VITE_API_URL=https://api.yourdomain.com/api

# Backend origin cho SignalR hubs và link xem trực tiếp
VITE_APP_URL=https://api.yourdomain.com

# Firebase Web config (Project Production)
VITE_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=panel-forge-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=panel-forge-prod
VITE_FIREBASE_STORAGE_BUCKET=panel-forge-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
