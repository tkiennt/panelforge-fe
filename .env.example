# Copy to .env. All values are optional for local development.

# Backend REST API base URL (Axios). Default: http://localhost:5044/api
VITE_API_URL=http://localhost:5044/api

# Backend origin for SignalR hubs and uploaded files. Default: http://localhost:5044
VITE_APP_URL=http://localhost:5044

# Firebase Web config, only needed for Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Do not put AI keys here: Gemini keys are configured per Workspace on the Backend.
